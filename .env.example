# Server Configuration
PORT=5001
NODE_ENV=development

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=7d

# Database Configuration (sqlite or mysql)
DB_DIALECT=sqlite

# MySQL Configuration (Optional: required only if DB_DIALECT=mysql)
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=walletwise_db

# Demo Transaction Limits
DEMO_MAX_ADD_AMOUNT=50000
DEMO_MAX_TRANSFER_AMOUNT=25000
DEMO_MAX_BILL_AMOUNT=20000
